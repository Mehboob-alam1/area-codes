PORT=5000
NODE_ENV=development

# Local JSON store is used when Supabase is not configured.
# Apply database/migrations/001_initial.sql in Supabase before using the service role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGIN=http://localhost:3000

# Required in production. The development server uses a local default and prints a warning.
ADMIN_JWT_SECRET=

# Created on first boot when the admin list is empty. Change this before any shared deployment.
ADMIN_BOOTSTRAP_EMAIL=admin@worldareacodes.local
ADMIN_BOOTSTRAP_PASSWORD=DirectoryAdmin!2026
ADMIN_BOOTSTRAP_NAME=Local Super Admin
